#!/bin/sh
# Blocks a commit made as anyone but the GitHub noreply address, or one that adds an employer identifier or a secret.
set -eu

noreply="35286616+varun-datt@users.noreply.github.com"
for ident in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  case "$(git var "$ident")" in
    *"<$noreply>"*) ;;
    *) echo "pre-commit: $ident is not <$noreply>; run: git config user.email $noreply" >&2; exit 1 ;;
  esac
done

exec python3 dotfiles/dot_agents/skills/commit-guard/scripts/guard.py --staged
