#!/bin/sh
# Refuses to push a commit whose author or committer is not the GitHub noreply address.
set -eu

noreply="35286616+varun-datt@users.noreply.github.com"
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
    set -- "$remote_sha..$local_sha"
  else
    set -- "$local_sha" --not --remotes
  fi
  bad=$(git log --format='%h %ae %ce' "$@" |
    awk -v ok="$noreply" '$2 != ok || ($3 != ok && $3 != "noreply@github.com") { print $1 }')
  if [ -n "$bad" ]; then
    echo "pre-push: commits made as another address: $(echo $bad)" >&2
    exit 1
  fi
done
