{{ if eq .chezmoi.os "windows" -}}
#!/usr/bin/env pwsh
{{ $code := merge (dig "codeLocal" (dict) .editor | deepCopy) .editor.code .editor.common -}}
{{ $cursor := merge (dig "cursorLocal" (dict) .editor | deepCopy) .editor.cursor .editor.common -}}
# hash: {{ printf "%s|%s|%s" ($code | toJson) ($cursor | toJson) (.editor.keybindings | toJson) | sha256sum }}

$base = $env:APPDATA

$settings = @{
  Code = @'
{{ $code | toPrettyJson }}
'@
  Cursor = @'
{{ $cursor | toPrettyJson }}
'@
}

function Merge-Settings($target, $source) {
  foreach ($key in @($source.Keys)) {
    if ($target.Contains($key) -and $target[$key] -is [System.Collections.IDictionary] -and $source[$key] -is [System.Collections.IDictionary]) {
      Merge-Settings $target[$key] $source[$key]
    } else {
      $target[$key] = $source[$key]
    }
  }
}

foreach ($app in 'Code', 'Cursor') {
  $dir = Join-Path $base "$app\User"
  New-Item -ItemType Directory -Force -Path $dir | Out-Null
  $path = Join-Path $dir 'settings.json'

  $managed = $settings[$app] | ConvertFrom-Json -AsHashtable
  $merged = $managed

  if (Test-Path $path) {
    try {
      $existing = Get-Content -Raw -Path $path | ConvertFrom-Json -AsHashtable
      if ($existing -is [System.Collections.IDictionary]) {
        Merge-Settings $existing $managed
        $merged = $existing
      }
    } catch {
      Copy-Item -Path $path -Destination "$path.bak" -Force
      Write-Warning "editor-settings: $path is not parseable JSON; backed it up to $path.bak"
    }
  }

  $merged | ConvertTo-Json -Depth 32 | Set-Content -Path $path -Encoding utf8
}
{{ if .editor.keybindings }}
$keybindings = @'
{{ .editor.keybindings | toPrettyJson }}
'@
foreach ($app in 'Code', 'Cursor') {
  Set-Content -Path (Join-Path $base "$app\User\keybindings.json") -Value $keybindings -Encoding utf8
}
{{ end -}}
{{ end -}}
